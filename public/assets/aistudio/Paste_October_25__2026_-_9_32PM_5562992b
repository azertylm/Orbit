  function buildVideoCard(v, rankNumber = null) {
    const platClass = `plat-${v.platform}`;
    const ratioClass = v.ratio === "9-16" ? "ratio-9-16" : "ratio-16-9";
    const rankHtml = rankNumber ? `<span style="background:var(--accent); color:#fff; padding:2px 8px; border-radius:6px; font-size:12px; margin-right:6px;">#${rankNumber}</span>` : "";
    const commentsHtml = (v.commentsList || []).map(c => `
      <div style="margin-bottom:4px;"><strong>${c.author} :</strong> <span style="color:var(--text-muted);">${c.text}</span></div>
    `).join('');

    return `
      <article class="vcard">
        <div class="vcard-header">
          <div class="author-wrap">
            <div class="avatar">${v.user.substring(0,2).toUpperCase()}</div>
            <div>
              <div style="font-size:13px; font-weight:800;">
                ${v.user} ${v.isFriend ? '<span style="color:var(--success); font-size:11px;">● Ami</span>' : ''}
              </div>
              <div style="font-size:11px; color:var(--text-muted);">Il y a ${v.hoursAgo}h</div>
            </div>
          </div>
          <span class="plat-pill ${platClass}">${v.platform}</span>
        </div>

        <div class="vcard-media ${ratioClass}" onclick="launchPipPlayer(${v.id})">
          <img src="${v.thumb}" alt="${v.title}" loading="lazy">
          <div class="media-overlay">
            <div class="play-trigger">▶</div>
          </div>
          <div class="badge-domain">${v.domain} › ${v.subdomain}</div>
          <div class="badge-score">★ <span class="js-score-${v.id}">${v.score.toFixed(1)}</span>/10</div>
        </div>

        <div class="vcard-body">
          <div>
            <h4 class="vcard-title">${rankHtml}${v.title}</h4>
            <p class="vcard-note-text" style="margin-top:8px;">"${v.comment}"</p>
          </div>

          <div class="vcard-footer">
            <div class="vote-row">
              <span style="font-size:11px; color:var(--text-muted); font-weight:700;">Noter :</span>
              <input type="range" min="1" max="10" step="0.5" value="${v.score.toFixed(1)}" class="slider"
                onchange="rateVideo(${v.id}, this.value)">
              <span style="font-size:11px; color:var(--text-muted);" class="js-votes-${v.id}">${v.votes} v.</span>
            </div>

            <div class="card-actions">
              <button class="action-link" onclick="toggleComments(${v.id})">
                💬 Discussion (${(v.commentsList || []).length})
              </button>
              <button class="action-link" onclick="repostToMyWall(${v.id})">
                🔁 Partager sur ma Page
              </button>
              <a href="${v.rawUrl}" target="_blank" class="action-link" style="text-decoration:none;">
                ↗ Source
              </a>
            </div>

            <div id="comments-${v.id}" class="comments-box">
              <div id="comments-list-${v.id}" style="margin-bottom:8px;">
                ${commentsHtml || '<div style="color:var(--text-muted);">Aucun commentaire pour le moment.</div>'}
              </div>
              <div style="display:flex; gap:6px;">
                <input type="text" id="comment-inp-${v.id}" placeholder="Ajouter un commentaire..." style="padding:6px 10px; font-size:12px;">
                <button class="btn btn-accent" style="padding:6px 10px; font-size:11px;" onclick="addComment(${v.id})">OK</button>
              </div>
            </div>
          </div>
        </div>
      </article>
    `;
  }

  function rateVideo(videoId, newNote) {
    const v = state.videos.find(item => item.id === videoId);
    if (!v) return;
    const val = parseFloat(newNote);
    v.score = ((v.score * v.votes) + val) / (v.votes + 1);
    v.votes += 1;

    // Mise à jour de l'affinité utilisateur dans le domaine voté
    const dom = state.domains.find(d => d.name === v.domain);
    if (dom && val >= 8) dom.affinity = Math.min(100, dom.affinity + 1);

    saveState();
    document.querySelectorAll(`.js-score-${v.id}`).forEach(el => el.textContent = v.score.toFixed(1));
    document.querySelectorAll(`.js-votes-${v.id}`).forEach(el => el.textContent = `${v.votes} v.`);
    renderProfile();
  }

  function toggleComments(videoId) {
    const box = document.getElementById(`comments-${videoId}`);
    if (box) box.classList.toggle('open');
  }

  function addComment(videoId) {
    const inp = document.getElementById(`comment-inp-${videoId}`);
    if (!inp || !inp.value.trim()) return;
    const v = state.videos.find(item => item.id === videoId);
    if (!v) return;
    v.commentsList = v.commentsList || [];
    v.commentsList.push({ author: state.profile.name, text: inp.value.trim() });
    inp.value = "";
    saveState();
    renderAll();
  }

  function repostToMyWall(videoId) {
    const orig = state.videos.find(item => item.id === videoId);
    if (!orig) return;
    const note = prompt("Ajouter un mot en partageant cette vidéo sur votre Page :", "Coup de cœur partagé sur mon mur !");
    if (note === null) return;
    const copy = {
      ...orig,
      id: Date.now(),
      user: state.profile.name,
      comment: note || orig.comment,
      hoursAgo: 1
    };
    state.videos.unshift(copy);
    saveState();
    renderAll();
  }

