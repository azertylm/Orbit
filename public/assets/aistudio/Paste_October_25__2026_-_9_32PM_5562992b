<!DOCTYPE html>
<html lang="fr" data-theme="onyx">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>ORBIT v2.0 — Réseau Social & Panthéon Vidéo Universel</title>
  <style>
    :root {
      --accent: #7c5cff;
      --accent-glow: rgba(124, 92, 255, 0.38);
      --accent-2: #00e5ff;
      --success: #00e676;
      --warning: #ffab00;
      --danger: #ff3d71;
      --radius-xl: 24px;
      --radius-lg: 18px;
      --radius-md: 12px;
      --radius-sm: 8px;
      --transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    }

    [data-theme="onyx"] {
      --bg-main: #07080d;
      --bg-surface: rgba(16, 18, 27, 0.85);
      --bg-card: rgba(24, 27, 40, 0.72);
      --bg-card-hover: rgba(34, 38, 56, 0.9);
      --bg-input: rgba(0, 0, 0, 0.35);
      --text-main: #f4f6fb;
      --text-muted: #8c93a8;
      --border: rgba(255, 255, 255, 0.08);
      --glass: blur(20px);
    }

    [data-theme="alabaster"] {
      --bg-main: #f4f3ef;
      --bg-surface: rgba(255, 255, 255, 0.9);
      --bg-card: #ffffff;
      --bg-card-hover: #f9f9fb;
      --bg-input: rgba(0, 0, 0, 0.04);
      --text-main: #121318;
      --text-muted: #62667a;
      --border: rgba(0, 0, 0, 0.09);
      --glass: blur(14px);
    }

    [data-theme="polar"] {
      --bg-main: #06101e;
      --bg-surface: rgba(16, 33, 58, 0.78);
      --bg-card: rgba(28, 52, 88, 0.45);
      --bg-card-hover: rgba(38, 68, 112, 0.65);
      --bg-input: rgba(0, 0, 0, 0.28);
      --text-main: #ffffff;
      --text-muted: #9bb3cc;
      --border: rgba(0, 229, 255, 0.16);
      --glass: blur(22px);
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Inter", "Segoe UI", Roboto, sans-serif;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      background-color: var(--bg-main);
      color: var(--text-main);
      min-height: 100vh;
      overflow-x: hidden;
      background-image: 
        radial-gradient(circle at 12% 8%, var(--accent-glow), transparent 32%),
        radial-gradient(circle at 88% 85%, rgba(0, 229, 255, 0.1), transparent 38%);
      background-attachment: fixed;
    }

    /* STRUCTURE PRINCIPALE */
    .app-shell {
      display: grid;
      grid-template-columns: 260px 1fr;
      min-height: 100vh;
      max-width: 1520px;
      margin: 0 auto;
    }

    /* SIDEBAR NAVIGATION */
    .sidebar {
      background: var(--bg-surface);
      backdrop-filter: var(--glass);
      -webkit-backdrop-filter: var(--glass);
      border-right: 1px solid var(--border);
      padding: 22px 16px;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: sticky;
      top: 0;
      height: 100vh;
      z-index: 200;
    }

    .brand-box {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 0 10px 20px;
      border-bottom: 1px solid var(--border);
    }

    .orbit-icon {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      color: #fff;
      font-size: 18px;
      box-shadow: 0 0 22px var(--accent-glow);
      position: relative;
      flex-shrink: 0;
    }

    .orbit-icon::after {
      content: '';
      position: absolute;
      width: 50px;
      height: 18px;
      border: 2px solid var(--accent-2);
      border-radius: 50%;
      transform: rotate(-24deg);
    }

    .brand-name {
      font-size: 22px;
      font-weight: 900;
      letter-spacing: 2.5px;
      background: linear-gradient(90deg, var(--text-main), var(--accent-2));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
    }

    .nav-menu {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-top: 20px;
      flex: 1;
    }

    .nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 13px 15px;
      border-radius: var(--radius-md);
      border: 1px solid transparent;
      background: transparent;
      color: var(--text-muted);
      font-size: 14px;
      font-weight: 700;
      cursor: pointer;
      transition: var(--transition);
      text-align: left;
    }

    .nav-item:hover {
      background: var(--bg-card);
      color: var(--text-main);
    }

    .nav-item.active {
      background: var(--accent);
      color: #fff;
      box-shadow: 0 8px 22px var(--accent-glow);
    }

    .nav-badge {
      margin-left: auto;
      font-size: 11px;
      padding: 2px 7px;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.16);
    }

    /* MAIN VIEWPORT */
    .viewport {
      padding: 22px 30px 110px;
      max-width: 1160px;
      width: 100%;
      margin: 0 auto;
    }

    /* TOPBAR */
    .topbar {
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      margin-bottom: 24px;
      flex-wrap: wrap;
    }

    .search-global {
      position: relative;
      flex: 1;
      min-width: 240px;
      max-width: 420px;
    }

    .search-global input {
      width: 100%;
      padding: 11px 16px 11px 38px;
      border-radius: 99px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-main);
      font-size: 13px;
      outline: none;
    }

    .search-global::before {
      content: '🔍';
      position: absolute;
      left: 13px;
      top: 50%;
      transform: translateY(-50%);
      font-size: 13px;
      opacity: 0.7;
    }

    .top-btn-group {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .btn {
      padding: 10px 15px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text-main);
      font-weight: 700;
      font-size: 12.5px;
      cursor: pointer;
      display: inline-flex;
      align-items: center;
      gap: 7px;
      transition: var(--transition);
    }

    .btn:hover {
      background: var(--bg-card-hover);
      transform: translateY(-1px);
    }

    .btn-accent {
      background: linear-gradient(135deg, var(--accent), #5e35ff);
      color: #fff;
      border: none;
      box-shadow: 0 4px 16px var(--accent-glow);
    }

    .btn-whatsapp {
      background: linear-gradient(135deg, #00c853, #009624);
      color: #fff;
      border: none;
    }

    /* PAGES */
    .page-section {
      display: none;
      animation: pageSlide 0.28s ease;
    }

    .page-section.active {
      display: block;
    }

    @keyframes pageSlide {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    .section-head {
      margin-bottom: 22px;
      display: flex;
      justify-content: space-between;
      align-items: flex-end;
      flex-wrap: wrap;
      gap: 12px;
    }

    .section-title {
      font-size: 26px;
      font-weight: 900;
      letter-spacing: -0.5px;
    }

    .section-desc {
      color: var(--text-muted);
      font-size: 13.5px;
      margin-top: 4px;
    }

    /* GLASS PANELS */
    .panel {
      background: var(--bg-card);
      backdrop-filter: var(--glass);
      -webkit-backdrop-filter: var(--glass);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      padding: 18px;
      margin-bottom: 20px;
    }

    /* COMPOSER INTELLIGENT */
    .composer-box {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .composer-row {
      display: grid;
      grid-template-columns: 1fr 200px 200px;
      gap: 10px;
    }

    input, select, textarea {
      width: 100%;
      padding: 11px 14px;
      border-radius: var(--radius-sm);
      border: 1px solid var(--border);
      background: var(--bg-input);
      color: var(--text-main);
      font-size: 13.5px;
      outline: none;
    }

    input:focus, select:focus, textarea:focus {
      border-color: var(--accent);
    }

    .ai-detect-banner {
      font-size: 12px;
      color: var(--accent-2);
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 6px 10px;
      border-radius: 8px;
      background: rgba(0, 229, 255, 0.08);
      border: 1px solid rgba(0, 229, 255, 0.2);
    }

    /* CHIPS & FILTRES */
    .chips-scroll {
      display: flex;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 10px;
      margin-bottom: 16px;
      scrollbar-width: thin;
    }

    .chip {
      padding: 7px 14px;
      border-radius: 99px;
      font-size: 12px;
      font-weight: 700;
      background: var(--bg-card);
      border: 1px solid var(--border);
      color: var(--text-muted);
      white-space: nowrap;
      cursor: pointer;
      transition: var(--transition);
    }

    .chip:hover, .chip.active {
      background: var(--text-main);
      color: var(--bg-main);
      border-color: transparent;
    }

    /* VIDEO GRID & CARDS */
    .video-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 20px;
    }

    .vcard {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: var(--radius-lg);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: var(--transition);
    }

    .vcard:hover {
      transform: translateY(-4px);
      border-color: var(--accent);
      box-shadow: 0 14px 34px rgba(0, 0, 0, 0.3);
    }

    .vcard-header {
      padding: 12px 15px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid var(--border);
    }

    .author-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
    }

    .avatar {
      width: 34px;
      height: 34px;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--accent), var(--accent-2));
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      font-size: 12px;
      color: #fff;
      flex-shrink: 0;
    }

    .plat-pill {
      font-size: 10px;
      font-weight: 800;
      padding: 3px 8px;
      border-radius: 99px;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .plat-youtube { background: rgba(255, 0, 0, 0.18); color: #ff5252; }
    .plat-tiktok { background: rgba(0, 242, 254, 0.18); color: #00f2fe; }
    .plat-instagram { background: rgba(225, 48, 108, 0.18); color: #ff6b9d; }
    .plat-twitch { background: rgba(145, 70, 255, 0.18); color: #b685ff; }

    .vcard-media {
      position: relative;
      width: 100%;
      background: #000;
      cursor: pointer;
      overflow: hidden;
    }

    .vcard-media.ratio-16-9 { aspect-ratio: 16 / 9; }
    .vcard-media.ratio-9-16 { aspect-ratio: 9 / 12; max-height: 350px; }

    .vcard-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0.88;
      transition: transform 0.35s ease;
    }

    .vcard:hover .vcard-media img {
      transform: scale(1.04);
    }

    .media-overlay {
      position: absolute;
      inset: 0;
      background: radial-gradient(circle, rgba(0,0,0,0.2) 0%, rgba(0,0,0,0.65) 100%);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .play-trigger {
      width: 52px;
      height: 52px;
      border-radius: 50%;
      background: rgba(124, 92, 255, 0.92);
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 19px;
      box-shadow: 0 0 24px var(--accent-glow);
      transition: var(--transition);
    }

    .vcard-media:hover .play-trigger {
      transform: scale(1.12);
    }

    .badge-domain {
      position: absolute;
      bottom: 10px;
      left: 10px;
      background: rgba(7, 8, 13, 0.86);
      backdrop-filter: blur(8px);
      color: #fff;
      padding: 4px 10px;
      border-radius: 8px;
      font-size: 11px;
      font-weight: 700;
      border: 1px solid rgba(255,255,255,0.14);
    }

    .badge-score {
      position: absolute;
      top: 10px;
      right: 10px;
      background: rgba(10, 12, 20, 0.92);
      color: #ffd700;
      padding: 5px 10px;
      border-radius: 10px;
      font-weight: 900;
      font-size: 13px;
      border: 1px solid rgba(255, 215, 0, 0.4);
    }

    .vcard-body {
      padding: 14px 16px;
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 12px;
    }

    .vcard-title {
      font-size: 15px;
      font-weight: 800;
      line-height: 1.35;
    }

    .vcard-note-text {
      font-size: 12.5px;
      color: var(--text-muted);
      font-style: italic;
      background: rgba(255,255,255,0.03);
      padding: 8px 10px;
      border-radius: 8px;
      border-left: 3px solid var(--accent);
    }

    .vcard-footer {
      border-top: 1px solid var(--border);
      padding-top: 10px;
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .vote-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }

    .slider {
      accent-color: var(--accent);
      cursor: pointer;
      height: 5px;
      flex: 1;
    }

    .card-actions {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
    }

    .action-link {
      background: none;
      border: none;
      color: var(--text-muted);
      cursor: pointer;
      font-weight: 600;
      font-size: 12px;
      display: inline-flex;
      align-items: center;
      gap: 4px;
    }

    .action-link:hover {
      color: var(--accent-2);
    }

    /* COMMENTS DRAWER IN CARD */
    .comments-box {
      display: none;
      margin-top: 8px;
      padding-top: 8px;
      border-top: 1px dashed var(--border);
      font-size: 12px;
    }

    .comments-box.open {
      display: block;
    }

    /* GRILLE DES 15 PILIERS (PAGE 3) */
    .pillars-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 10px;
      margin-bottom: 16px;
    }

    .pillar-card {
      padding: 12px;
      border-radius: var(--radius-md);
      background: var(--bg-card);
      border: 1px solid var(--border);
      cursor: pointer;
      transition: var(--transition);
      display: flex;
      align-items: center;
      gap: 10px;
      font-size: 12.5px;
      font-weight: 800;
    }

    .pillar-card:hover, .pillar-card.active {
      background: var(--accent);
      color: #fff;
      border-color: transparent;
      box-shadow: 0 6px 18px var(--accent-glow);
    }

    /* ADN CULTUREL (PAGE 2) */
    .dna-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 12px;
    }

    .dna-card {
      padding: 12px 14px;
      border-radius: var(--radius-md);
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--border);
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .dna-card.is-secret {
      opacity: 0.5;
      border-style: dashed;
    }

    .bar-bg {
      height: 7px;
      background: rgba(255,255,255,0.08);
      border-radius: 99px;
      overflow: hidden;
    }

    .bar-fill {
      height: 100%;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      border-radius: 99px;
    }

    /* MINI LECTEUR PERSISTANT PICTURE-IN-PICTURE (PiP) */
    .pip-dock {
      position: fixed;
      bottom: 22px;
      right: 22px;
      width: 340px;
      background: var(--bg-surface);
      backdrop-filter: var(--glass);
      border: 1px solid var(--accent);
      border-radius: var(--radius-lg);
      box-shadow: 0 18px 45px rgba(0,0,0,0.65);
      z-index: 950;
      overflow: hidden;
      display: none;
      animation: pageSlide 0.25s ease;
    }

    .pip-dock.active {
      display: block;
    }

    .pip-header {
      padding: 8px 12px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 12px;
      font-weight: 800;
      background: rgba(0,0,0,0.4);
    }

    .pip-screen {
      width: 100%;
      aspect-ratio: 16 / 9;
      background: #000;
    }

    /* MODALES */
    .modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.78);
      backdrop-filter: blur(10px);
      display: none;
      align-items: center;
      justify-content: center;
      z-index: 1100;
      padding: 16px;
    }

    .modal-overlay.open {
      display: flex;
    }

    .modal-window {
      background: var(--bg-surface);
      border: 1px solid var(--border);
      border-radius: var(--radius-xl);
      max-width: 620px;
      width: 100%;
      padding: 24px;
      max-height: 90vh;
      overflow-y: auto;
    }

    /* RESPONSIVE MOBILE */
    @media (max-width: 900px) {
      .app-shell { grid-template-columns: 1fr; }
      .sidebar {
        position: fixed;
        bottom: 0;
        top: auto;
        left: 0;
        right: 0;
        height: 68px;
        flex-direction: row;
        padding: 6px 8px;
        border-right: none;
        border-top: 1px solid var(--border);
      }
      .brand-box, .sidebar-foot { display: none; }
      .nav-menu {
        flex-direction: row;
        margin-top: 0;
        width: 100%;
        justify-content: space-around;
      }
      .nav-item {
        flex-direction: column;
        gap: 3px;
        padding: 7px 6px;
        font-size: 11px;
        flex: 1;
        justify-content: center;
        text-align: center;
      }
      .nav-badge { display: none; }
      .viewport { padding: 14px 12px 92px; }
      .composer-row { grid-template-columns: 1fr; }
      .pip-dock { bottom: 76px; right: 10px; width: 280px; }
    }
  </style>
</head>
<body>

<div class="app-shell">
  <!-- NAVIGATION : LES 4 PAGES FONDAMENTALES -->
  <aside class="sidebar">
    <div>
      <div class="brand-box">
        <div class="orbit-icon">O</div>
        <div>
          <div class="brand-name">ORBIT</div>
          <div style="font-size:10px; color:var(--text-muted); letter-spacing:1px;">UNIVERS SOCIAL VIDÉO</div>
        </div>
      </div>

      <nav class="nav-menu">
        <button class="nav-item active" onclick="goPage('p1', this)">
          <span>⚡</span><span>Le Flux</span><span class="nav-badge">P.1</span>
        </button>
        <button class="nav-item" onclick="goPage('p2', this)">
          <span>👤</span><span>Ma Page</span><span class="nav-badge">P.2</span>
        </button>
        <button class="nav-item" onclick="goPage('p3', this)">
          <span>🏆</span><span>Le Panthéon</span><span class="nav-badge">P.3</span>
        </button>
        <button class="nav-item" onclick="goPage('p4', this)">
          <span>🧭</span><span>Le Radar</span><span class="nav-badge">P.4</span>
        </button>
      </nav>
    </div>

    <div class="sidebar-foot" style="padding:10px; font-size:11.5px; color:var(--text-muted); border-top:1px solid var(--border);">
      <div style="font-weight:700; color:var(--text-main); margin-bottom:4px;">État du Moteur Local</div>
      <div>● 15 Piliers / 105 Sous-domaines</div>
      <div>● Sauvegarde Auto Active</div>
      <button class="btn" style="width:100%; margin-top:10px; justify-content:center; font-size:11px;" onclick="exportOrbitData()">
        💾 Exporter Base JSON
      </button>
    </div>
  </aside>

  <!-- CONTENU PRINCIPAL -->
  <main class="viewport">
    <!-- BARRE SUPÉRIEURE -->
    <header class="topbar">
      <div class="search-global">
        <input type="text" id="global-search" placeholder="Rechercher une vidéo, un domaine, un ami, un mot-clé..." oninput="handleGlobalSearch(this.value)">
      </div>
      <div class="top-btn-group">
        <button class="btn btn-accent" onclick="openModal('modal-sync')">
          🔗 Connecteurs Réseaux (<span id="sync-counter">4</span>/6)
        </button>
        <button class="btn btn-whatsapp" onclick="openModal('modal-capsule')">
          🎁 Capsule Ami (WhatsApp)
        </button>
        <button class="btn" onclick="openModal('modal-design')">
          🎨 Studio Design
        </button>
      </div>
    </header>

    <!-- ==========================================================
         PAGE 1 : LE FLUX (ABONNEMENTS, AMIS & PARTAGE MULTI-RÉSEAUX)
         ========================================================== -->
    <section id="p1" class="page-section active">
      <div class="section-head">
        <div>
          <h1 class="section-title">⚡ Le Flux de vos Abonnements</h1>
          <p class="section-desc">Partagez et notez le meilleur de YouTube, TikTok, Instagram et Twitch sans aucun hébergement lourd.</p>
        </div>
      </div>

      <!-- Publieur avec Auto-Classification Intelligente -->
