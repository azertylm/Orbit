    if (val < 35) {
      label.textContent = `Mode Haute Affinité (${100 - val}% cœur de cible) : Priorité absolue à vos domaines favoris.`;
    } else if (val < 70) {
      label.textContent = `Mode Équilibré : Mélange optimal entre vos passions et des pépites d'autres domaines.`;
    } else {
      label.textContent = `Mode Exploration Hors-Piste (${val}%) : Découverte des meilleures vidéos dans les domaines que vous connaissez moins !`;
    }
    renderRadar();
  }

  /* =========================================================================
     11. LECTEUR PICTURE-IN-PICTURE (PiP) PERSISTANT ENTRE LES 4 PAGES
     ========================================================================= */
  function launchPipPlayer(videoId) {
    const v = state.videos.find(item => item.id === videoId);
    if (!v) return;
    const dock = document.getElementById('pip-dock');
    document.getElementById('pip-title').textContent = v.title;
    document.getElementById('pip-domain').textContent = `${v.domain} › ${v.subdomain}`;
    document.getElementById('pip-external').href = v.rawUrl;

    document.getElementById('pip-screen').innerHTML = `
      <iframe width="100%" height="100%"
        src="https://www.youtube-nocookie.com/embed/${v.youtubeId}?autoplay=1"
        frameborder="0" allow="autoplay; encrypted-media" allowfullscreen>
      </iframe>
    `;
    dock.classList.add('active');
  }

  function closePip() {
    document.getElementById('pip-dock').classList.remove('active');
    document.getElementById('pip-screen').innerHTML = '';
  }

  /* =========================================================================
     12. CONNECTEURS SOCIAUX, CAPSULE VIRALE WHATSAPP & THÈMES
     ========================================================================= */
  function renderHeaderSync() {
    const count = state.socials.filter(s => s.active).length;
    document.getElementById('sync-counter').textContent = count;
  }

  function renderSocialModal() {
    const box = document.getElementById('sync-list');
    box.innerHTML = state.socials.map(s => `
      <div onclick="toggleSocial('${s.id}')" style="padding:12px; border-radius:12px; border:1px solid ${s.active ? 'var(--success)' : 'var(--border)'}; background:${s.active ? 'rgba(0,230,118,0.08)' : 'var(--bg-card)'}; cursor:pointer; display:flex; justify-content:space-between; align-items:center;">
        <div>
          <div style="font-weight:800; font-size:13px;">${s.name}</div>
          <div style="font-size:11px; color:var(--text-muted);">${s.desc}</div>
        </div>
        <span style="font-size:12px; font-weight:800; color:${s.active ? 'var(--success)' : 'var(--text-muted)'};">
          ${s.active ? '✓ Actif' : 'Activer'}
        </span>
      </div>
    `).join('');
  }

  function toggleSocial(id) {
    const item = state.socials.find(s => s.id === id);
    if (item) {
      item.active = !item.active;
      saveState();
      renderHeaderSync();
      renderSocialModal();
      renderProfile();
    }
  }

  function initCapsuleModal() {
    const sel = document.getElementById('cap-domain');
    sel.innerHTML = state.domains.map(d => `<option value="${d.name}">${d.icon} ${d.name} (${d.affinity}% d'affinité)</option>`).join('');
    updateCapsulePreview();
  }

  function updateCapsulePreview() {
    const friend = document.getElementById('cap-friend').value || "mon ami";
    const domain = document.getElementById('cap-domain').value || "Musique & Son";
    const box = document.getElementById('cap-preview-box');
    box.innerHTML = `
      "Salut <strong>${friend}</strong> ! Je t'ai préparé ta capsule vidéo personnalisée sur <strong>ORBIT</strong> dans le domaine <strong>${domain}</strong>. J'ai sélectionné 3 pépites qui correspondent à 95% à nos goûts communs, viens voir ton profil pré-rempli !"
    `;
  }

  function shareCapsuleWhatsApp() {
    const friend = document.getElementById('cap-friend').value || "ami";
    const domain = document.getElementById('cap-domain').value;
    const text = encodeURIComponent(`Salut ${friend} ! Je t'ai préparé ta sélection vidéo sur ORBIT dans la catégorie "${domain}" (95% d'affinité avec nos goûts). Découvre tes 3 vidéos ici : https://orbit-app.fr/?capsule=${encodeURIComponent(friend)}&domain=${encodeURIComponent(domain)}`);
    window.open(`https://wa.me/?text=${text}`, '_blank');
  }

  function copyCapsuleText() {
    const friend = document.getElementById('cap-friend').value || "ami";
    const domain = document.getElementById('cap-domain').value;
    const text = `Salut ${friend} ! Viens voir les 3 vidéos que j'ai choisies pour toi sur ORBIT (${domain}) : https://orbit-app.fr/?capsule=${encodeURIComponent(friend)}`;
    navigator.clipboard.writeText(text);
    alert("Invitation copiée dans le presse-papiers !");
  }

  function openModal(id) { document.getElementById(id).classList.add('open'); }
  function closeModal(id) { document.getElementById(id).classList.remove('open'); }

  function applyTheme(themeName, save = true) {
    document.documentElement.setAttribute('data-theme', themeName);
    state.theme = themeName;
    if (save) saveState();
  }

  function applyAccent(hex, save = true) {
    document.documentElement.style.setProperty('--accent', hex);
    document.documentElement.style.setProperty('--accent-glow', hex + '55');
    state.accent = hex;
    if (save) saveState();
  }

  window.addEventListener('DOMContentLoaded', initOrbit);
</script>
</body>
</html>
