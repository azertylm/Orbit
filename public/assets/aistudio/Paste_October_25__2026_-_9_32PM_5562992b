    // Tri par affinité utilisateur (inclut aussi les domaines en Jardin Secret !)
    list.sort((a, b) => {
      const domA = state.domains.find(d => d.name === a.domain)?.affinity || 50;
      const domB = state.domains.find(d => d.name === b.domain)?.affinity || 50;
      return state.radarExploration > 60 ? (domA - domB) : (domB - domA);
    });

    radarGrid.innerHTML = list.map(v => buildVideoCard(v)).join('');
