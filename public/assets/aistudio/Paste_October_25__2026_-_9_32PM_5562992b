  function renderPantheonVideos() {
    const grid = document.getElementById('pantheon-grid');
    let list = state.videos.filter(v => v.domain === state.activePillar);
    if (state.activeSubpillar !== "Tous") {
      list = list.filter(v => v.subdomain === state.activeSubpillar);
    }
    if (list.length === 0) {
      list = [...state.videos];
    }

    // Moteur mathématique de Gravité Temporelle (renouvelle le Top)
    list.sort((a, b) => {
      if (state.pantheonMode === 'gravity') {
        const gA = (a.score * Math.log10(a.votes + 10)) / Math.pow(a.hoursAgo + 2, 0.65);
        const gB = (b.score * Math.log10(b.votes + 10)) / Math.pow(b.hoursAgo + 2, 0.65);
        return gB - gA;
      }
      if (state.pantheonMode === 'emerging') return a.hoursAgo - b.hoursAgo;
      if (state.pantheonMode === 'alltime') return (b.score * b.votes) - (a.score * a.votes);
      return b.score - a.score;
    });

    grid.innerHTML = list.map((v, i) => buildVideoCard(v, i + 1)).join('');
  }

