  function parseVideoUrl(url) {
    let platform = "youtube";
    let ratio = "16-9";
    let youtubeId = "aircAruvnKk";

    const ytRegex = /(?:youtube\.com\/(?:[^\/]+\/.+\/|(?:v|e(?:mbed)?|shorts)\/|.*[?&]v=)|youtu\.be\/)([^"&?\/\s]{11})/i;
    const match = url.match(ytRegex);
    if (match && match[1]) {
      youtubeId = match[1];
    }

    if (url.includes("shorts/")) {
      platform = "youtube";
      ratio = "9-16";
    } else if (url.includes("tiktok.com")) {
      platform = "tiktok";
      ratio = "9-16";
    } else if (url.includes("instagram.com")) {
      platform = "instagram";
      ratio = "9-16";
    } else if (url.includes("twitch.tv")) {
      platform = "twitch";
      ratio = "16-9";
    }

    const thumb = (platform === "youtube" && match)
      ? `https://img.youtube.com/vi/${youtubeId}/hqdefault.jpg`
      : "https://images.unsplash.com/photo-1618005182384-a83a8bd57fbe?auto=format&fit=crop&w=800&q=80";

    return { platform, ratio, youtubeId, thumb };
  }

  function autoClassifyInput() {
    const url = document.getElementById('inp-url').value.toLowerCase();
    const title = document.getElementById('inp-title').value.toLowerCase();
    const combined = `${url} ${title}`;
    const banner = document.getElementById('ai-classifier-status');

    if (combined.trim().length < 3) return;

    for (const dom of state.domains) {
      for (const kw of dom.keywords) {
        if (combined.includes(kw)) {
          document.getElementById('inp-domain').value = dom.name;
          populateComposerSubdomains();
          banner.innerHTML = `✨ <strong>IA Auto-Tri :</strong> Classé dans <u>${dom.icon} ${dom.name}</u> (mot-clé détecté : "${kw}")`;
          return;
        }
      }
    }

    const parsed = parseVideoUrl(url);
    banner.innerHTML = `📡 Plateforme détectée : <strong>${parsed.platform.toUpperCase()}</strong> (Format ${parsed.ratio})`;
  }

  function submitNewVideo() {
    const rawUrl = document.getElementById('inp-url').value.trim();
    const titleInput = document.getElementById('inp-title').value.trim();
    const commentInput = document.getElementById('inp-comment').value.trim();
    const domain = document.getElementById('inp-domain').value;
    const subdomain = document.getElementById('inp-subdomain').value;

    if (!rawUrl && !titleInput) {
      alert("Indiquez au moins un lien vidéo (YouTube, TikTok, Insta...) ou un titre.");
      return;
    }

    const parsed = parseVideoUrl(rawUrl || "https://youtube.com");
    const newVideo = {
      id: Date.now(),
      title: titleInput || `Découverte ${parsed.platform.toUpperCase()} — ${subdomain}`,
      platform: parsed.platform,
      ratio: parsed.ratio,
      domain,
      subdomain,
      user: state.profile.name,
      isFriend: true,
      comment: commentInput || "Je partage cette pépite avec vous !",
      score: 9.6,
      votes: 1,
      hoursAgo: 1,
      youtubeId: parsed.youtubeId,
      rawUrl: rawUrl || `https://www.youtube.com/watch?v=${parsed.youtubeId}`,
      thumb: parsed.thumb,
      commentsList: []
    };

    state.videos.unshift(newVideo);

    // Augmente automatiquement l'affinité de l'utilisateur dans ce domaine
    const domObj = state.domains.find(d => d.name === domain);
    if (domObj && domObj.affinity < 99) domObj.affinity = Math.min(100, domObj.affinity + 2);

    saveState();
    document.getElementById('inp-url').value = "";
    document.getElementById('inp-title').value = "";
    document.getElementById('inp-comment').value = "";
    renderAll();
  }

  /* =========================================================================
